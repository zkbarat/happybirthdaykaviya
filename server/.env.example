# =====================================================================
#  Birthday website — backend environment variables
#  Copy this file to ".env" and fill in whichever ONE channel you want.
#  You only need to configure a SINGLE channel for it to work.
#  The server tries: WhatsApp -> Telegram -> Email (first configured wins)
# =====================================================================

# Port the API listens on (Render/Railway set this automatically)
PORT=4000

# Your deployed frontend URL(s), comma-separated, for CORS.
# Leave empty during local development.
# Example: CLIENT_ORIGIN=https://her-birthday.vercel.app
CLIENT_ORIGIN=

# ---------------------------------------------------------------------
# OPTION 1 — WhatsApp Cloud API  (preferred)
# Get these from https://developers.facebook.com  → your WhatsApp app.
#   - WHATSAPP_ACCESS_TOKEN:   temporary or permanent access token
#   - WHATSAPP_PHONE_NUMBER_ID: the ID of your WhatsApp sender number
#   - MY_WHATSAPP_NUMBER:      YOUR number in full intl. format, no "+",
#                              no spaces. Example: 919812345678
# NOTE: To receive a message, your number must be added as a recipient
#       in the Meta dashboard (or your app must be in production mode).
# ---------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MY_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------
# OPTION 2 — Telegram Bot  (easiest & free)
#   1. Message @BotFather on Telegram, send /newbot, copy the token.
#   2. Message your new bot once (say "hi").
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates to find your
#      numeric chat id, and paste it below.
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# OPTION 3 — Email via Resend  (https://resend.com, free tier)
#   - RESEND_API_KEY: from the Resend dashboard
#   - EMAIL_FROM:     a verified sender, e.g. onboarding@resend.dev
#   - EMAIL_TO:       your email address
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=
