# Frontend environment (optional)
#
# If you deploy the frontend and backend SEPARATELY, point the frontend
# at your backend by setting this to the backend's base URL, then update
# client/src/config.ts giftApiEndpoint if needed.
#
# For most setups you don't need this file at all — the Vite dev proxy
# and the "serve frontend from backend" option handle everything.
VITE_API_BASE=
